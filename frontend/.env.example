# ─────────────────────────────────────────────
# ApplyWise Frontend — Environment Variables
# Copy this file to .env and fill in real values
#
# IMPORTANT: Vite bakes these values in at BUILD time.
# Set them before running `npm run build`, not just at runtime.
# ─────────────────────────────────────────────

# ── API ───────────────────────────────────────
# URL of your deployed Flask backend (no trailing slash)
# Local dev (default if unset):
# VITE_API_URL=http://localhost:5000/api
# Production:
VITE_API_URL=https://your-backend.onrender.com/api
