{
  "manifest_version": 3,
  "name": "ApplyWise Job Tracker",
  "version": "1.0.1",
  "description": "One-Click Job Application Tracker",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "options_page": "options/index.html",
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "Save to ApplyWise"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["config.js", "content/extractors.js", "content/content.js"],
      "run_at": "document_idle"
    }
  ]
}
