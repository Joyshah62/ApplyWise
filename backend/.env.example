# ─────────────────────────────────────────────
# ApplyWise Backend — Environment Variables
# Copy this file to .env and fill in real values
# ─────────────────────────────────────────────

# ── Security ─────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex-string
JWT_SECRET_KEY=change-me-to-a-different-random-64-char-hex-string

# ── Database ──────────────────────────────────
# Leave unset to use a local SQLite file (applywise.db)
# For Neon / Supabase / Railway Postgres:
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/applywise?sslmode=require
# For a local Postgres instance:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/applywise

# ── AI / Groq ─────────────────────────────────
# Get your key at https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional Fallback API keys (used automatically if the primary key hits rate/quota limits)
# You can specify them individually:
GROQ_API_KEY_FALLBACK_1=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_API_KEY_FALLBACK_2=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Or as a comma-separated list of keys:
# GROQ_API_KEYS=key1,key2,key3

# Per-user daily limit for AI calls (resume analysis, cover letters)
DAILY_AI_LIMIT=20

# ── CORS ──────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
# Local dev:
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Production:
ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://your-admin.vercel.app

# ── Flask ─────────────────────────────────────
# Set to "true" only for local development — NEVER in production
FLASK_DEBUG=false
FLASK_ENV=production

# Port used by run.py (dev server only — gunicorn uses $PORT from platform)
PORT=5000
